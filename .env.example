# ==========================================
# SarkariSach Environment Variables
# ==========================================

# Google Gemini API Key (Required for AI LLM vision/audio analysis; rules engine works offline without key)
GEMINI_API_KEY=

# Gemini Model variant
GEMINI_MODEL=gemini-2.5-flash

# Database connection string (SQLite default)
DATABASE_URL=sqlite:///./sarkarisach.db

# Telegram Bot Token (Optional, from @BotFather)
TELEGRAM_BOT_TOKEN=

# API Rate limit
RATE_LIMIT_PER_MINUTE=30/minute

